rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vishwakarmaarjun128@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(sid) { return request.auth != null && request.auth.uid == sid; }
    function salonOpen(sid) {
      let s = get(/databases/$(database)/documents/salons/$(sid)).data;
      return s.active == true && s.sub.expires > request.time.toMillis();
    }
    function offerOf(oid) { return get(/databases/$(database)/documents/offers/$(oid)).data; }
    function offerLive(o) {
      return o.active == true && (o.get('endsAt', 0) == 0 || o.endsAt > request.time.toMillis());
    }
    // owner opens a free-days scratch card: only sub.expires moves, by exactly the card's days, once per card
    function claimUpdate(sid) {
      let oid = request.resource.data.lastClaim;
      let o = offerOf(oid);
      let add = o.days * 86400000;
      let oldE = resource.data.sub.expires;
      let newE = request.resource.data.sub.expires;
      let nowMs = request.time.toMillis();
      return isOwner(sid)
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sub', 'lastClaim'])
        && request.resource.data.sub.diff(resource.data.sub).affectedKeys().hasOnly(['expires'])
        && offerLive(o) && o.kind == 'days' && o.days > 0 && o.days <= 30
        && !exists(/databases/$(database)/documents/salons/$(sid)/claims/$(oid))
        && existsAfter(/databases/$(database)/documents/salons/$(sid)/claims/$(oid))
        && (newE == oldE + add || (oldE < nowMs && newE >= nowMs + add - 600000 && newE <= nowMs + add + 600000));
    }
    function claimDocOk(sid, oid) {
      let o = offerOf(oid);
      let days = o.get('days', 0);
      return offerLive(o)
        && (o.get('newSince', 0) == 0 || get(/databases/$(database)/documents/salons/$(sid)).data.get('createdAt', 0) >= o.newSince)
        && request.resource.data.keys().hasOnly(['oid', 'days', 'at'])
        && request.resource.data.oid == oid
        && request.resource.data.days == days
        && (days == 0 || getAfter(/databases/$(database)/documents/salons/$(sid)).data.get('lastClaim', '') == oid);
    }

    // pitch game leads: anyone can add one (only these fields), add the game result once within a day; only admin reads
    match /leads/{lid} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'salon', 'phone', 'lang', 'at', 'src'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.salon is string && request.resource.data.salon.size() > 0 && request.resource.data.salon.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('[6-9][0-9]{9}')
        && request.resource.data.lang in ['en', 'hi']
        && request.resource.data.src == 'pitch'
        && request.resource.data.at is int;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks', 'lost', 'avg', 'doneAt'])
        && resource.data.at > request.time.toMillis() - 86400000
        && request.resource.data.picks is list && request.resource.data.picks.size() <= 3
        && request.resource.data.lost is int && request.resource.data.lost >= 0 && request.resource.data.lost <= 30
        && request.resource.data.avg is int && request.resource.data.avg >= 0 && request.resource.data.avg <= 5000
        && request.resource.data.doneAt is int
      );
    }

    match /offers/{oid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /{path=**}/claims/{cid} {
      allow read: if isAdmin();
    }

    match /salons/{sid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isOwner(sid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.sub.plan == null
        && request.resource.data.sub.expires <= request.time.toMillis() + 8 * 86400000;
      allow update: if isAdmin()
        || (isOwner(sid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sub', 'active', 'ownerUid', 'payments', 'lastClaim', 'createdAt']))
        || claimUpdate(sid);
      allow delete: if isAdmin();

      match /bookings/{bid} {
        allow read, update, delete: if isOwner(sid) || isAdmin();
        allow create: if isOwner(sid) || isAdmin() || (
          salonOpen(sid)
          && request.resource.data.keys().hasOnly(['date', 'time', 'serviceId', 'barberId', 'cust', 'phone', 'email', 'status', 'created', 'src'])
          && request.resource.data.status == 'booked'
          && request.resource.data.src == 'online'
          && request.resource.data.cust is string && request.resource.data.cust.size() > 0 && request.resource.data.cust.size() <= 60
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 15
          && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 100))
        );
      }

      match /claims/{oid} {
        allow read: if isOwner(sid) || isAdmin();
        allow create: if isOwner(sid) && claimDocOk(sid, oid);
        allow update: if isOwner(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicked'])
          && request.resource.data.clicked == true;
        allow delete: if isAdmin();
      }

      match /private/{docId} {
        allow read, write: if isOwner(sid) || isAdmin();
      }

      match /days/{date} {
        allow read: if true;
        allow write: if isOwner(sid) || isAdmin();
        allow create: if salonOpen(sid)
          && request.resource.data.keys().hasOnly(['slots'])
          && request.resource.data.slots.size() == 1;
        allow update: if salonOpen(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])
          && request.resource.data.slots.diff(resource.data.slots).addedKeys().size() == 1
          && request.resource.data.slots.diff(resource.data.slots).changedKeys().size() == 0
          && request.resource.data.slots.diff(resource.data.slots).removedKeys().size() == 0;
      }
    }
  }
}
