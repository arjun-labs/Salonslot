rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vishwakarmaarjun128@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(sid) {
      return request.auth != null && (request.auth.uid == sid
        || (isAdmin() && sid.matches(request.auth.uid + '_(clinic|spa|other)')));
    }
    // staff: a Google email the owner added in staffIndex (doc id = lowercase email) pointing at this salon
    function isStaff(sid) {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staffIndex/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/staffIndex/$(request.auth.token.email.lower())).data.sid == sid;
    }
    // role of the staff member (reception, doctor, manager); a doctor is tied to one barberId (his own queue)
    function staffRec() { return get(/databases/$(database)/documents/staffIndex/$(request.auth.token.email.lower())).data; }
    function isFront(sid) { return isStaff(sid) && staffRec().role in ['reception', 'manager']; }
    function isDocStaff(sid) { return isStaff(sid) && staffRec().role == 'doctor'; }
    function ownPatient(sid) { return isDocStaff(sid) && resource.data.barberId == staffRec().get('barberId', ''); }
    function salonOpen(sid) {
      let s = get(/databases/$(database)/documents/salons/$(sid)).data;
      return s.active == true && s.sub.expires > request.time.toMillis();
    }
    function offerOf(oid) { return get(/databases/$(database)/documents/offers/$(oid)).data; }
    function offerLive(o) {
      return o.active == true && (o.get('endsAt', 0) == 0 || o.endsAt > request.time.toMillis());
    }
    // owner opens a free-days scratch card: only sub.expires moves, by exactly the card's days, once per card
    function claimUpdate(sid) {
      let oid = request.resource.data.lastClaim;
      let o = offerOf(oid);
      let add = o.days * 86400000;
      let oldE = resource.data.sub.expires;
      let newE = request.resource.data.sub.expires;
      let nowMs = request.time.toMillis();
      return isOwner(sid)
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sub', 'lastClaim'])
        && request.resource.data.sub.diff(resource.data.sub).affectedKeys().hasOnly(['expires'])
        && offerLive(o) && o.kind == 'days' && o.days > 0 && o.days <= 30
        && !exists(/databases/$(database)/documents/salons/$(sid)/claims/$(oid))
        && existsAfter(/databases/$(database)/documents/salons/$(sid)/claims/$(oid))
        && (newE == oldE + add || (oldE < nowMs && newE >= nowMs + add - 600000 && newE <= nowMs + add + 600000));
    }
    function claimDocOk(sid, oid) {
      let o = offerOf(oid);
      let days = o.get('days', 0);
      return offerLive(o)
        && (o.get('newSince', 0) == 0 || get(/databases/$(database)/documents/salons/$(sid)).data.get('createdAt', 0) >= o.newSince)
        && request.resource.data.keys().hasOnly(['oid', 'days', 'at'])
        && request.resource.data.oid == oid
        && request.resource.data.days == days
        && (days == 0 || getAfter(/databases/$(database)/documents/salons/$(sid)).data.get('lastClaim', '') == oid);
    }

    // pitch game leads: anyone can add one (only these fields), add the game result once within a day; only admin reads
    match /leads/{lid} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'salon', 'area', 'phone', 'lang', 'at', 'src'])
        && (!('area' in request.resource.data) || (request.resource.data.area is string && request.resource.data.area.size() <= 60))
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.salon is string && request.resource.data.salon.size() > 0 && request.resource.data.salon.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('[6-9][0-9]{9}')
        && request.resource.data.lang in ['en', 'hi']
        && request.resource.data.src == 'pitch'
        && request.resource.data.at is int;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks', 'lost', 'avg', 'doneAt'])
        && resource.data.at > request.time.toMillis() - 86400000
        && request.resource.data.picks is list && request.resource.data.picks.size() <= 3
        && request.resource.data.lost is int && request.resource.data.lost >= 0 && request.resource.data.lost <= 30
        && request.resource.data.avg is int && request.resource.data.avg >= 0 && request.resource.data.avg <= 5000
        && request.resource.data.doneAt is int
      );
    }

    match /staffIndex/{em} {
      allow get: if isAdmin() || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == em);
      allow list: if isAdmin() || (request.auth != null && resource.data.sid == request.auth.uid);
      allow create, update: if isOwner(request.resource.data.sid)
        && request.resource.data.keys().hasOnly(['sid', 'role', 'barberId', 'name', 'rev', 'at'])
        && request.resource.data.role in ['reception', 'doctor', 'manager']
        && (request.resource.data.role != 'doctor' || (request.resource.data.get('barberId', '') is string && request.resource.data.get('barberId', '').size() > 0));
      allow delete: if isOwner(resource.data.sid) || isAdmin();
    }

    match /offers/{oid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /{path=**}/claims/{cid} {
      allow read: if isAdmin();
    }

    match /salons/{sid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isOwner(sid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.sub.plan == null
        && request.resource.data.sub.expires <= request.time.toMillis() + 8 * 86400000;
      allow update: if isAdmin()
        || (isOwner(sid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sub', 'active', 'ownerUid', 'payments', 'lastClaim', 'createdAt']))
        || (isFront(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['billSeq', 'gstSeq']))
        || claimUpdate(sid);
      allow delete: if isAdmin();

      match /bookings/{bid} {
        // owner, admin, reception, manager: all bookings. A doctor: only his own patients, and he can only mark one done.
        allow read: if isOwner(sid) || isAdmin() || isFront(sid) || ownPatient(sid);
        allow update: if isOwner(sid) || isAdmin() || isFront(sid)
          || (ownPatient(sid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
              && request.resource.data.status == 'done');
        allow delete: if isOwner(sid) || isAdmin();
        allow create: if isOwner(sid) || isAdmin() || isFront(sid) || (
          salonOpen(sid)
          && request.resource.data.keys().hasOnly(['date', 'time', 'serviceId', 'barberId', 'cust', 'phone', 'email', 'status', 'created', 'src', 'extra', 'dur', 'token', 'problem'])
          && (!('extra' in request.resource.data) || (request.resource.data.extra is list && request.resource.data.extra.size() <= 10))
          && (!('problem' in request.resource.data) || (request.resource.data.problem is string && request.resource.data.problem.size() <= 300))
          && (!('token' in request.resource.data) || (request.resource.data.token is int && request.resource.data.token > 0))
          && (!('dur' in request.resource.data) || (request.resource.data.dur is int && request.resource.data.dur > 0 && request.resource.data.dur <= 720))
          && request.resource.data.status == 'booked'
          && request.resource.data.src == 'online'
          && request.resource.data.cust is string && request.resource.data.cust.size() > 0 && request.resource.data.cust.size() <= 60
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 15
          && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 100))
        );
      }

      match /claims/{oid} {
        allow read: if isOwner(sid) || isAdmin();
        allow create: if isOwner(sid) && claimDocOk(sid, oid);
        allow update: if isOwner(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicked'])
          && request.resource.data.clicked == true;
        allow delete: if isAdmin();
      }

      match /private/{docId} {
        allow read, write: if isOwner(sid) || isAdmin();
      }

      match /queue/{date} {
        allow read: if true;
        allow write: if isOwner(sid) || isAdmin() || isStaff(sid);
      }

      match /days/{date} {
        allow read: if true;
        allow write: if isOwner(sid) || isAdmin() || isFront(sid);
        allow create: if salonOpen(sid)
          && request.resource.data.keys().hasOnly(['slots', 'tok'])
          && request.resource.data.slots.size() == 1
          && (!('tok' in request.resource.data) || request.resource.data.tok.size() == 1);
        allow update: if salonOpen(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'tok'])
          && (!('tok' in request.resource.data) || request.resource.data.tok.diff(resource.data.get('tok', {})).affectedKeys().size() <= 1)
          && request.resource.data.slots.diff(resource.data.slots).addedKeys().size() == 1
          && request.resource.data.slots.diff(resource.data.slots).changedKeys().size() == 0
          && request.resource.data.slots.diff(resource.data.slots).removedKeys().size() == 0;
      }
    }

    // ---------- Field team app (/field): attendance, visits with photo ----------
    // field_staff doc id = lowercase Gmail. Admin adds people; the person only records their own consent.
    function fEmail() { return request.auth.token.email.lower(); }
    function fStaffDoc() { return get(/databases/$(database)/documents/field_staff/$(request.auth.token.email.lower())).data; }
    function isFieldStaff() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/field_staff/$(request.auth.token.email.lower()))
        && fStaffDoc().active == true;
    }
    function fieldReady() { return isFieldStaff() && fStaffDoc().get('consentAt', 0) > 0; }
    function nowNear(ms) { return ms is int && ms > request.time.toMillis() - 600000 && ms < request.time.toMillis() + 600000; }
    function isLoc(l) { return l is map && l.lat is number && l.lng is number; }

    match /field_staff/{em} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == em);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == em && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consentAt', 'consentVer'])
        && nowNear(request.resource.data.consentAt));
    }

    // field_days doc id = email + '_' + yyyy-mm-dd. Staff can start a day and close it once; only admin can fix a day.
    match /field_days/{did} {
      allow read: if isAdmin() || (isFieldStaff() && resource.data.email == fEmail());
      allow create: if fieldReady()
        && request.resource.data.keys().hasOnly(['email', 'name', 'kind', 'date', 'start', 'out', 'hours', 'startLoc'])
        && request.resource.data.email == fEmail()
        && request.resource.data.date is string && request.resource.data.date.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
        && did == request.resource.data.email + '_' + request.resource.data.date
        && nowNear(request.resource.data.start)
        && request.resource.data.out == 0
        && isLoc(request.resource.data.startLoc);
      allow update: if isAdmin() || (isFieldStaff() && resource.data.email == fEmail() && resource.data.out == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['out', 'hours', 'outLoc'])
        && nowNear(request.resource.data.out)
        && request.resource.data.hours is number && request.resource.data.hours >= 0 && request.resource.data.hours <= 24
        && (!('outLoc' in request.resource.data) || isLoc(request.resource.data.outLoc)));
      allow delete: if isAdmin();
    }

    // A visit needs its photo doc written in the same batch, an open day, a valid phone and a location.
    match /field_visits/{vid} {
      allow read: if isAdmin() || (isFieldStaff() && resource.data.email == fEmail());
      allow create: if fieldReady()
        && request.resource.data.keys().hasOnly(['email', 'name', 'date', 'dayId', 'salon', 'owner', 'phone', 'demo', 'result', 'follow', 'thumb', 'loc', 'at'])
        && request.resource.data.email == fEmail()
        && request.resource.data.date is string && request.resource.data.date.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.dayId == request.resource.data.email + '_' + request.resource.data.date
        && get(/databases/$(database)/documents/field_days/$(request.resource.data.dayId)).data.out == 0
        && request.resource.data.salon is string && request.resource.data.salon.size() > 0 && request.resource.data.salon.size() <= 80
        && request.resource.data.owner is string && request.resource.data.owner.size() > 0 && request.resource.data.owner.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.matches('[6-9][0-9]{9}')
        && request.resource.data.demo is bool
        && request.resource.data.result in ['interest', 'later', 'refused', 'signup']
        && request.resource.data.follow is string && request.resource.data.follow.size() <= 10
        && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 30000
        && request.resource.data.thumb.matches('data:image/jpeg;base64,.*')
        && isLoc(request.resource.data.loc)
        && nowNear(request.resource.data.at)
        && existsAfter(/databases/$(database)/documents/field_photos/$(vid));
      allow update, delete: if isAdmin();
    }

    match /field_photos/{vid} {
      allow read: if isAdmin() || (isFieldStaff() && resource.data.email == fEmail());
      allow create: if fieldReady()
        && request.resource.data.keys().hasOnly(['email', 'photo', 'at'])
        && request.resource.data.email == fEmail()
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 700000
        && request.resource.data.photo.matches('data:image/jpeg;base64,.*')
        && nowNear(request.resource.data.at);
      allow delete: if isAdmin();
    }
  }
}
