rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vishwakarmaarjun128@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(sid) { return request.auth != null && request.auth.uid == sid; }
    function salonOpen(sid) {
      let s = get(/databases/$(database)/documents/salons/$(sid)).data;
      return s.active == true && s.sub.expires > request.time.toMillis();
    }

    match /salons/{sid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isOwner(sid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.sub.plan == null
        && request.resource.data.sub.expires <= request.time.toMillis() + 8 * 86400000;
      allow update: if isAdmin()
        || (isOwner(sid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sub', 'active', 'ownerUid', 'payments']));
      allow delete: if isAdmin();

      match /bookings/{bid} {
        allow read, update, delete: if isOwner(sid) || isAdmin();
        allow create: if isOwner(sid) || isAdmin() || (
          salonOpen(sid)
          && request.resource.data.keys().hasOnly(['date', 'time', 'serviceId', 'barberId', 'cust', 'phone', 'email', 'status', 'created', 'src'])
          && request.resource.data.status == 'booked'
          && request.resource.data.src == 'online'
          && request.resource.data.cust is string && request.resource.data.cust.size() > 0 && request.resource.data.cust.size() <= 60
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 15
          && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 100))
        );
      }

      match /days/{date} {
        allow read: if true;
        allow write: if isOwner(sid) || isAdmin();
        allow create: if salonOpen(sid)
          && request.resource.data.keys().hasOnly(['slots'])
          && request.resource.data.slots.size() == 1;
        allow update: if salonOpen(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])
          && request.resource.data.slots.diff(resource.data.slots).addedKeys().size() == 1
          && request.resource.data.slots.diff(resource.data.slots).changedKeys().size() == 0
          && request.resource.data.slots.diff(resource.data.slots).removedKeys().size() == 0;
      }
    }
  }
}
